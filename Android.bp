android_app {
    name: "MiniVChat",
    srcs: ["java/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    static_libs: [
        "mini-v-aidl-java",
    ],

    kotlincflags: ["-Xjvm-default=all"],

    platform_apis: true,
    privileged: true,
    certificate: "platform",

    optimize: {
        enabled: false,
    },
}